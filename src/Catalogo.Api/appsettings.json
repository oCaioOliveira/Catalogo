{
  "ENVIRONMENT": "__ENVIRONMENT__",
  "CORS_ALLOW": "__CORS_ALLOW__",
  "DB_DATABASE": "__DB_DATABASE__",
  "DB_SERVER": "__DB_SERVER__",
  "DB_USER": "__DB_USER__",
  "DB_PASSWORD": "__DB_PASSWORD__",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Update": "None"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emissor": "catalogo-api",
    "Audiencia": "catalogo",
    "ValidadeHoras": 8
  },
  "Seguranca": {
    "CacheUsuarioSegundos": 60,
    "LoginLimitePorMinuto": 10
  },
  "Exportacao": {
    "LimiteLinhas": 10000,
    "FusoHorario": "America/Sao_Paulo"
  },
  "Painel": {
    "FusoHorario": "America/Sao_Paulo",
    "DiasPendenteAntigo": 7,
    "MinimoAvaliacoesRanking": 3
  }
}
