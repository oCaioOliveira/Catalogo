<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Identifica o "cofre" local do user-secrets (connection string em desenvolvimento). -->
    <UserSecretsId>catalogo-api-0b6c1e2a-5d3f-4c8e-9a71-2f4e8d9c6b10</UserSecretsId>
    <!-- Os <summary> dos controllers viram as descrições do OpenAPI (ConfiguracaoSwagger). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: nem todo tipo público da Api precisa de comentário XML (só o que aparece no contrato). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Catalogo.Application\Catalogo.Application.csproj" />
    <!-- Só para registrar a injeção de dependência no Program.cs (garantido por teste de arquitetura). -->
    <ProjectReference Include="..\Catalogo.Infrastructure\Catalogo.Infrastructure.csproj" />
  </ItemGroup>
</Project>
