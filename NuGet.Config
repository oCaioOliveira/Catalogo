<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Evita herdar feeds da máquina/agente de CI (ex.: Nexus HTTP). -->
    <clear />
    <add key="BibliotecasCAIXA" value="https://alm.ceaus.df.caixa/CEGTI/_packaging/Bibliotecas/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Obrigatório com Central Package Management quando há potencial de múltiplas fontes. -->
  <packageSourceMapping>
    <packageSource key="BibliotecasCAIXA">
      <package pattern="CAIXA.*" />
      <package pattern="Caixa.*" />
      <package pattern="BibliotecasCAIXA.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
