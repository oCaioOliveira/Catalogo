<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Evita herdar feeds da máquina/agente de CI. -->
    <clear />
    <add key="BibliotecasCAIXA" value="https://alm.ceaus.df.caixa/CEGTI/_packaging/Bibliotecas/nuget/v3/index.json" />
    <!-- Feed corporativo para pacotes públicos. -->
    <add key="Nexus" value="http://binario.caixa:8081/repository/nuget-group/index.json" protocolVersion="3" allowInsecureConnections="true" />
  </packageSources>

  <!-- Obrigatório com Central Package Management quando há potencial de múltiplas fontes. -->
  <packageSourceMapping>
    <packageSource key="BibliotecasCAIXA">
      <package pattern="CAIXA.*" />
      <package pattern="Caixa.*" />
      <package pattern="BibliotecasCAIXA.*" />
    </packageSource>
    <packageSource key="Nexus">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
