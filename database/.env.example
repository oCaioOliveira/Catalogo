# Copie para database/.env (que NÃO vai para o git) e troque as senhas.
# Regras das senhas: 8+ caracteres, com maiúsculas, minúsculas, números e símbolos.
# Evite os caracteres $ ' " e espaços nas senhas (eles quebram o .env ou os scripts SQL).

# Senha do administrador (sa). Só para administrar o banco local, nunca na aplicação.
MSSQL_SA_PASSWORD=TroqueEsta#Senha1

# Senha do login listagem_app, que é o que a aplicação usa.
APP_DB_PASSWORD=TroqueEsta#App1

# Porta exposta no seu computador.
MSSQL_PORT=1433

# Collation do servidor. Deve ser igual à de produção.
# Só vale ao criar o volume: depois de mudar, faça o reset (ver README).
MSSQL_COLLATION=Latin1_General_CI_AI
