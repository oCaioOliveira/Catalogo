<?xml version="1.0" encoding="utf-8"?>
<!--
  Origem única de pacotes para a solução. Com o gerenciamento central de pacotes (Directory.Packages.props)
  e TreatWarningsAsErrors, ter mais de uma origem sem mapeamento quebra o restore (NU1507).
  O <clear /> ignora as origens configuradas na máquina (ex.: feeds internos).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
