{
  "name": "catalogo-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCatalogo",
    "lint": "ng lint",
    "gerar-api": "node scripts/gerar-api.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\"",
    "test:watch": "ng test",
    "e2e": "playwright test",
    "e2e:ng-serve": "E2E_NG_SERVE=1 playwright test",
    "servir-build": "node scripts/servir-build.mjs",
    "dados-dev": "node tools/dados-dev/popular.mjs"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~20.3.0",
    "@angular/cdk": "~20.2.0",
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@fontsource/inter": "^5.3.0",
    "@primeuix/themes": "^1.2.5",
    "chart.js": "^4.5.1",
    "primeicons": "^7.0.0",
    "primeng": "~20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "~20.3.40",
    "@angular/cli": "~20.3.40",
    "@angular/compiler-cli": "~20.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.20.5",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "exceljs": "^4.4.0",
    "jasmine-core": "~5.9.0",
    "jszip": "^3.10.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  }
}
